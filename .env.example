# CampusAI Environment Variables

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CampusAI

# Backend Configuration (see backend/.env.example for detailed backend config)
# Copy backend/.env.example to backend/.env and update values

# Development Settings
DEBUG=true
ENVIRONMENT=development

# Note:
# - Copy this file to .env and update values
# - Never commit .env files to version control
# - Frontend env vars must start with NEXT_PUBLIC_ to be accessible in browser
